<div class="book-cta" id="bookCta"><a href="#contact" data-en="Book Your Event ↗" data-ro="Rezervă Eveniment ↗">Book Your Event ↗</a></div>

<div class="lightbox" id="lightbox">
  <button class="lightbox-close" onclick="closeLightbox()">×</button>
  <button class="lightbox-nav lightbox-prev" onclick="changeLightbox(-1)">‹</button>
  <img src="" id="lightboxImg">
  <button class="lightbox-nav lightbox-next" onclick="changeLightbox(1)">›</button>
</div>

<script>
  const gallery = ["images/si lounge interior empty.jpg","images/garden crowded.jpg","images/carousel bar.jpg","images/not just a venue.jpeg","images/corporate.jpeg","images/garden empty wedding setup.jpeg","images/garden jewel in the heart of bucharest.jpeg","images/si lounge interior crowded.jpeg","images/the shared garden carousel.jpeg","images/nayam interior.jpg"];
  let lbIdx = 0;
  function openGallery(i){ lbIdx = i; document.getElementById("lightboxImg").src = gallery[i]; document.getElementById("lightbox").classList.add("open"); }
  function closeLightbox(){ document.getElementById("lightbox").classList.remove("open"); }
  function changeLightbox(d){ lbIdx = (lbIdx + d + gallery.length) % gallery.length; document.getElementById("lightboxImg").src = gallery[lbIdx]; }

  const nav = document.getElementById('nav'), bookCta = document.getElementById('bookCta');
  window.addEventListener('scroll', () => { nav.classList.toggle('scrolled', window.scrollY > 50); nav.classList.toggle('nav--light', window.scrollY <= 50); bookCta.classList.toggle('on', window.scrollY > 400); });

  const ham = document.getElementById('ham'), mobNav = document.getElementById('mobNav');
  ham.addEventListener('click', () => { mobNav.classList.toggle('open'); ham.classList.toggle('open'); });
  function closeMob() { mobNav.classList.remove('open'); ham.classList.remove('open'); }

  const themeToggle = document.getElementById('themeToggle'), themeIcon = document.getElementById('themeIcon');
  const sun = '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
  const moon = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
  let isDark = false;
  themeToggle.addEventListener('click', () => { isDark = !isDark; document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light'); themeIcon.innerHTML = isDark ? sun : moon; });
  themeIcon.innerHTML = moon;

  let currentLang = 'en';
  function setLang(l){
    currentLang = l;
    document.querySelectorAll('[data-en][data-ro]').forEach(el => {
      const val = el.getAttribute('data-' + l);
      if(val.indexOf('<') !== -1) el.innerHTML = val;
      else el.textContent = val;
    });
    document.getElementById('langToggle').textContent = l === 'en' ? 'RO' : 'EN';
  }
  document.getElementById('langToggle').addEventListener('click', () => setLang(currentLang === 'en' ? 'ro' : 'en'));

  const reveals = document.querySelectorAll('.reveal');
  const obs = new IntersectionObserver(entries => entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('on'); }), { threshold: 0.1 });
  reveals.forEach(r => obs.observe(r));

  const sidebar = document.getElementById('evSidebar');
  document.getElementById('evSidebarTab').addEventListener('click', () => sidebar.classList.toggle('open'));
  document.addEventListener('click', e => { if(sidebar.classList.contains('open') && !sidebar.contains(e.target) && e.target.id !== 'evSidebarTab') sidebar.classList.remove('open'); });

  const sl = document.getElementById('baSlider');
  if(sl){
    const after = sl.querySelector('.ba-after'), handle = sl.querySelector('.ba-handle');
    const move = (e) => {
      let rect = sl.getBoundingClientRect(), x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
      let p = Math.max(0, Math.min(100, (x / rect.width) * 100));
      if(after) after.style.clipPath = `inset(0 ${100-p}% 0 0)`;
      if(handle) handle.style.left = p + '%';
    };
    sl.addEventListener('mousemove', move); sl.addEventListener('touchmove', e => { e.preventDefault(); move(e); }, {passive:false});
  }

  (function(){
    if(sessionStorage.getItem('dismiss-pop')) return;
    setTimeout(() => { if(document.getElementById('popupModal')) document.getElementById('popupModal').classList.add('open'); }, 1000);
  })();
  function closePopup(){ document.getElementById('popupModal').classList.remove('open'); }
  function closePopupSession(){ closePopup(); sessionStorage.setItem('dismiss-pop', '1'); }

  const vid = document.getElementById('heroVideo');
  if(vid) vid.addEventListener('timeupdate', () => { if(vid.duration && vid.currentTime >= vid.duration - 3) vid.currentTime = 0; });
</script>
</body>
</html>
